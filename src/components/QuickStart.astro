---
/**
 * @file QuickStart.astro
 * @description Sección de inicio rápido con pestañas de comando (npx, npm global, pnpm dlx) y características principales.
 */
---

<section class="section" id="quickstart">
  <div class="container">
    <div class="section-header">
      <div class="badge-eyebrow" data-i18n="qs_eyebrow">Installation & Usage</div>
      <h2 class="section-title" data-i18n="qs_title">Get Started in Seconds</h2>
      <p class="section-subtitle" data-i18n="qs_subtitle">
        Zero global setup required. Run on demand with npx or install globally for maximum convenience.
      </p>
    </div>

    <div class="quickstart-grid">
      <!-- Installation Tabs Box -->
      <div class="glass-card install-card">
        <div class="card-tab-header">
          <button class="tab-btn active" data-target="tab-npx">
            <span class="tab-badge" data-i18n="tab_npx_badge">Recommended</span>
            <span data-i18n="tab_npx_title">npx (No Install)</span>
          </button>
          <button class="tab-btn" data-target="tab-global" data-i18n="tab_global_title">
            npm global
          </button>
          <button class="tab-btn" data-target="tab-pnpm" data-i18n="tab_pnpm_title">
            pnpm dlx
          </button>
        </div>

        <div class="tab-content-wrapper">
          <!-- Tab 1: NPX -->
          <div class="tab-panel active" id="tab-npx">
            <p class="panel-desc" data-i18n="qs_npx_desc">Run directly without installing any global packages. Ideal for one-off commits or CI/CD environments.</p>
            <div class="code-block">
              <pre><code><span class="token-cmd">npx</span> wcommits <span class="token-flag">-t</span> feat <span class="token-flag">-m</span> <span class="token-string">"add user authentication"</span></code></pre>
              <button class="code-copy-btn" data-code='npx wcommits -t feat -m "add user authentication"'>Copy</button>
            </div>
            <div class="panel-note">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
              <span data-i18n="qs_npx_note">Automatically downloads and executes the latest version of wcommits.</span>
            </div>
          </div>

          <!-- Tab 2: Global -->
          <div class="tab-panel" id="tab-global">
            <p class="panel-desc" data-i18n="qs_global_desc">Install globally to use wcommits directly from anywhere in your shell.</p>
            <div class="code-block">
              <pre><code><span class="token-cmd">npm</span> install -g wcommits</code></pre>
              <button class="code-copy-btn" data-code="npm install -g wcommits">Copy</button>
            </div>
            <p class="panel-desc" style="margin-top: 1rem;" data-i18n="qs_global_then">Then use it directly anytime:</p>
            <div class="code-block">
              <pre><code><span class="token-cmd">wcommits</span> <span class="token-flag">-t</span> fix <span class="token-flag">-s</span> api <span class="token-flag">-m</span> <span class="token-string">"handle null response"</span></code></pre>
              <button class="code-copy-btn" data-code='wcommits -t fix -s api -m "handle null response"'>Copy</button>
            </div>
          </div>

          <!-- Tab 3: PNPM -->
          <div class="tab-panel" id="tab-pnpm">
            <p class="panel-desc" data-i18n="qs_pnpm_desc">For pnpm users who prefer fast package execution without global pollution.</p>
            <div class="code-block">
              <pre><code><span class="token-cmd">pnpm</span> dlx wcommits <span class="token-flag">-t</span> refactor <span class="token-flag">-m</span> <span class="token-string">"simplify auth middleware"</span></code></pre>
              <button class="code-copy-btn" data-code='pnpm dlx wcommits -t refactor -m "simplify auth middleware"'>Copy</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Feature Cards Column -->
      <div class="feature-highlights">
        <div class="glass-card feature-mini">
          <div class="mini-icon icon-cyan">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
          </div>
          <div class="mini-body">
            <h4 data-i18n="feat_clipboard_title">Native Clipboard Copy</h4>
            <p data-i18n="feat_clipboard_desc">Automatically copies output to clipboard using macOS (pbcopy), Windows (clip), or Linux (xclip/xsel).</p>
          </div>
        </div>

        <div class="glass-card feature-mini">
          <div class="mini-icon icon-emerald">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          </div>
          <div class="mini-body">
            <h4 data-i18n="feat_validation_title">Strict Spec Validation</h4>
            <p data-i18n="feat_validation_desc">Prevents typos and invalid types before they enter your commit log. Instant errors for missing mandatory flags.</p>
          </div>
        </div>

        <div class="glass-card feature-mini">
          <div class="mini-icon icon-purple">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
          </div>
          <div class="mini-body">
            <h4 data-i18n="feat_deps_title">Zero Runtime Dependencies</h4>
            <p data-i18n="feat_deps_desc">Lightweight pure Node.js CLI with zero external package bloat. Blazing fast startup speed and tiny footprint.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .quickstart-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .install-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .card-tab-header {
    display: flex;
    background: rgba(15, 23, 42, 0.9);
    border-bottom: 1px solid var(--border-color);
    padding: 0.5rem;
    gap: 0.5rem;
  }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .tab-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.04);
  }

  .tab-btn.active {
    background: rgba(0, 242, 254, 0.12);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 242, 254, 0.3);
  }

  .tab-badge {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--accent-cyan);
    color: #07090e;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  .tab-content-wrapper {
    padding: 1.75rem;
    flex: 1;
  }

  .tab-panel {
    display: none;
    flex-direction: column;
    gap: 1rem;
  }

  .tab-panel.active {
    display: flex;
  }

  .panel-desc {
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .code-block {
    position: relative;
    background: #090d16;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    overflow-x: auto;
  }

  .code-block pre {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: #e2e8f0;
    margin: 0;
  }

  .token-cmd { color: var(--accent-emerald); font-weight: 600; }
  .token-flag { color: var(--accent-cyan); }
  .token-string { color: var(--accent-amber); }

  .code-copy-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 0.75rem;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .code-copy-btn:hover {
    background: rgba(0, 242, 254, 0.2);
    color: #ffffff;
    border-color: var(--accent-cyan);
  }

  .panel-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.02);
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .panel-note code {
    color: var(--accent-cyan);
  }

  .feature-highlights {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .feature-mini {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.25rem;
  }

  .mini-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-cyan { background: rgba(0, 242, 254, 0.1); color: var(--accent-cyan); border: 1px solid rgba(0, 242, 254, 0.3); }
  .icon-emerald { background: rgba(52, 211, 153, 0.1); color: var(--accent-emerald); border: 1px solid rgba(52, 211, 153, 0.3); }
  .icon-purple { background: rgba(192, 132, 252, 0.1); color: var(--accent-purple); border: 1px solid rgba(192, 132, 252, 0.3); }

  .mini-body h4 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
    color: #ffffff;
  }

  .mini-body p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .quickstart-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { copyAndNotify } from '../services/feedback';
  import { i18n } from '../i18n/i18n-service';

  // Tab switcher
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active'));
      tabPanels.forEach(p => p.classList.remove('active'));

      btn.classList.add('active');
      const targetId = btn.getAttribute('data-target');
      if (targetId) {
        document.getElementById(targetId)?.classList.add('active');
      }
    });
  });

  // Code Copy Buttons
  document.querySelectorAll('#quickstart .code-copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const code = btn.getAttribute('data-code');
      if (code) {
        copyAndNotify(code, i18n.t('toast_copied'));
      }
    });
  });
</script>
